{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/shared/**/*", "src/core/**/*", "src/main/**/*", "src/daemon/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
