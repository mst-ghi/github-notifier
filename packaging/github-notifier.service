[Unit]
Description=GitHub Notifier background service (webhooks, polling, desktop notifications)
Documentation=https://github.com/mostafa/github-notifier
# Best-effort ordering only: this is a user unit, so it must not hard-depend on
# a system service it cannot see.
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

# Give up restarting after 5 failures in 5 minutes so a broken config does not
# spin forever. These belong to [Unit]; systemd ignores them under [Service].
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple

# The daemon runs on Electron's bundled Node so the .deb needs no separate
# nodejs package, and so it can read the app out of the asar archive.
Environment=ELECTRON_RUN_AS_NODE=1
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
# The database is a single file under $XDG_DATA_HOME/github-notifier.
# Override its location with: systemctl --user edit github-notifier
#   Environment=GHN_DB_PATH=/path/to/github-notifier.db

# Both paths are quoted: the install directory contains a space, and systemd
# splits ExecStart on whitespace, so an unquoted form tries to run "/opt/GitHub"
# and dies with status=203/EXEC.
ExecStart="/opt/GitHub Notifier/github-notifier" "/opt/GitHub Notifier/resources/app.asar/dist/daemon/index.js"

# Notifications and the keyring both need the session bus. systemd user
# services normally inherit it; this makes the dependency explicit.
ExecStartPre=/bin/sh -c 'test -n "$DBUS_SESSION_BUS_ADDRESS" || echo "warning: no session bus, desktop notifications may not appear"'

Restart=on-failure
RestartSec=10

TimeoutStopSec=15
KillSignal=SIGTERM

# Long-running desktop helper: keep it out of the way of real work.
Nice=5
IOSchedulingClass=idle
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=github-notifier

# Light hardening. The daemon only needs its own config/state dirs, the
# network, and the session bus.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
